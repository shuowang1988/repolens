# RepoLens — published artifacts only.
#
# The cloned corpus (~1.8 GB of third-party source) must NOT be published:
# RepoLens stores and redistributes only DERIVED STATISTICS, never upstream code.
corpus/

# Derived statistics ARE published on purpose — they carry no third-party source
# and they are what makes the paper's numbers independently verifiable:
#   runs/balanced/features.json        extracted features (41 repos)
#   runs/balanced/derived_truth.json   every number quoted in the paper
#   runs/balanced/dashboard.html       the offline artifact (self-contained)
#   runs/figures/*.png                 the four figures
# Do not add those to this file.

# Local noise
__pycache__/
*.pyc
.venv/
.vscode/
.idea/

